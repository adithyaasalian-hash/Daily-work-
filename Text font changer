<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AI Image Text Font Changer</title>

<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #111827, #312e81);
    color: white;
    min-height: 100vh;
}

header {
    text-align: center;
    padding: 20px 10px;
}

header h1 {
    margin: 0;
    font-size: 28px;
}

header p {
    color: #cbd5e1;
}

.toolbar {
    width: 95%;
    max-width: 900px;
    margin: auto;
    padding: 15px;
    background: rgba(255,255,255,.08);
    border-radius: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
}

button,
select,
input {
    font-size: 15px;
}

button,
select {
    padding: 10px 14px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
}

button {
    background: #06b6d4;
    color: white;
    font-weight: bold;
}

button:hover {
    background: #0891b2;
}

.download {
    background: #22c55e;
}

.download:hover {
    background: #16a34a;
}

#workspace {
    width: 95%;
    max-width: 1000px;
    margin: 20px auto;
    padding: 15px;
    background: rgba(0,0,0,.25);
    border-radius: 18px;
    text-align: center;
}

#canvasBox {
    position: relative;
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    border-radius: 12px;
}

#canvas {
    max-width: 100%;
    display: block;
}

#loading {
    margin: 15px;
    color: #67e8f9;
}

.controls {
    width: 95%;
    max-width: 900px;
    margin: 20px auto;
    padding: 18px;
    background: rgba(255,255,255,.08);
    border-radius: 16px;
}

.controls h3 {
    margin-top: 0;
}

.control-row {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    align-items: center;
    margin: 12px 0;
}

.control-row label {
    min-width: 100px;
}

input[type="range"] {
    width: 180px;
}

input[type="color"] {
    width: 50px;
    height: 35px;
    border: none;
    background: transparent;
}

#detectedList {
    width: 95%;
    max-width: 900px;
    margin: 15px auto;
}

.text-item {
    background: rgba(255,255,255,.1);
    margin: 6px 0;
    padding: 10px;
    border-radius: 10px;
    cursor: pointer;
}

.text-item:hover {
    background: rgba(255,255,255,.2);
}

.selected {
    outline: 2px solid #22d3ee;
}

small {
    color: #cbd5e1;
}
</style>
</head>

<body>

<header>
    <h1>🖼️ AI Image Text Font Changer</h1>
    <p>Upload an image → Detect text → Change font → Download</p>
</header>

<div class="toolbar">

    <input
        type="file"
        id="imageInput"
        accept="image/*"
    >

    <button onclick="detectText()">
        🔍 Detect Text
    </button>

    <button onclick="resetImage()">
        🔄 Reset
    </button>

    <button class="download" onclick="downloadImage()">
        💾 Download
    </button>

</div>

<div id="loading"></div>

<div id="workspace">

    <div id="canvasBox">
        <canvas id="canvas"></canvas>
    </div>

</div>

<div class="controls">

    <h3>🔤 Text Controls</h3>

    <div class="control-row">

        <label>Font:</label>

        <select id="fontSelect">
            <option value="Arial">Arial</option>
            <option value="Verdana">Verdana</option>
            <option value="Georgia">Georgia</option>
            <option value="Times New Roman">Times New Roman</option>
            <option value="Courier New">Courier New</option>
            <option value="Trebuchet MS">Trebuchet MS</option>
            <option value="Impact">Impact</option>
            <option value="Comic Sans MS">Comic Sans MS</option>
            <option value="Lucida Console">Lucida Console</option>
            <option value="Palatino Linotype">Palatino</option>
            <option value="Tahoma">Tahoma</option>
            <option value="Garamond">Garamond</option>
        </select>

    </div>

    <div class="control-row">

        <label>Size:</label>

        <input
            type="range"
            id="fontSize"
            min="8"
            max="150"
            value="40"
        >

        <span id="sizeValue">40</span>

    </div>

    <div class="control-row">

        <label>Color:</label>

        <input
            type="color"
            id="fontColor"
            value="#ffffff"
        >

    </div>

    <div class="control-row">

        <label>Style:</label>

        <button onclick="toggleBold()">
            <b>B</b>
        </button>

        <button onclick="toggleItalic()">
            <i>I</i>
        </button>

    </div>

    <div class="control-row">

        <label>Opacity:</label>

        <input
            type="range"
            id="opacity"
            min="0"
            max="100"
            value="100"
        >

    </div>

    <small>
        Select detected text below, then change its appearance.
        You can drag the replacement text on the image.
    </small>

</div>

<div id="detectedList">

    <h3>🔎 Detected Text</h3>

    <div id="textResults">
        No text detected yet.
    </div>

</div>


<script>

const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");

const imageInput =
    document.getElementById("imageInput");

const fontSelect =
    document.getElementById("fontSelect");

const fontSize =
    document.getElementById("fontSize");

const sizeValue =
    document.getElementById("sizeValue");

const fontColor =
    document.getElementById("fontColor");

const opacity =
    document.getElementById("opacity");

const loading =
    document.getElementById("loading");

const textResults =
    document.getElementById("textResults");

let originalImage = new Image();

let detectedWords = [];

let selectedIndex = -1;

let bold = false;
let italic = false;

let dragging = false;
let dragOffsetX = 0;
let dragOffsetY = 0;


// ---------------- IMAGE UPLOAD ----------------

imageInput.addEventListener("change", function(e) {

    const file = e.target.files[0];

    if (!file) return;

    const reader = new FileReader();

    reader.onload = function(event) {

        originalImage.onload = function() {

            canvas.width = originalImage.width;
            canvas.height = originalImage.height;

            redraw();

        };

        originalImage.src = event.target.result;
    };

    reader.readAsDataURL(file);

});


// ---------------- DRAW ORIGINAL IMAGE ----------------

function redraw() {

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    ctx.drawImage(
        originalImage,
        0,
        0,
        canvas.width,
        canvas.height
    );

    detectedWords.forEach((word, index) => {

        if (word.replaced) {

            drawReplacement(
                word,
                index
            );

        }

    });

}


// ---------------- OCR ----------------

async function detectText() {

    if (!originalImage.src) {

        alert("Please upload an image first.");

        return;
    }

    loading.innerHTML =
        "⏳ AI is reading the image...";

    textResults.innerHTML =
        "Detecting...";

    try {

        const result =
            await Tesseract.recognize(
                originalImage.src,
                "eng",
                {
                    logger: message => {

                        if (message.status === "recognizing text") {

                            const percent =
                                Math.round(
                                    message.progress * 100
                                );

                            loading.innerHTML =
                                `🔍 Reading text... ${percent}%`;
                        }

                    }
                }
            );

        detectedWords = [];

        const words =
            result.data.words;

        words.forEach(word => {

            if (
                word.text &&
                word.text.trim() !== "" &&
                word.confidence > 30
            ) {

                detectedWords.push({

                    text: word.text,

                    x: word.bbox.x0,

                    y: word.bbox.y0,

                    width:
                        word.bbox.x1 -
                        word.bbox.x0,

                    height:
                        word.bbox.y1 -
                        word.bbox.y0,

                    replaced: false,

                    font:
                        "Arial",

                    size:
                        Math.max(
                            15,
                            word.bbox.y1 -
                            word.bbox.y0
                        ),

                    color:
                        "#ffffff",

                    opacity:
                        1,

                    bold:
                        false,

                    italic:
                        false

                });

            }

        });

        loading.innerHTML =
            `✅ Found ${detectedWords.length} text items`;

        showDetectedText();

        redraw();

    } catch (error) {

        console.error(error);

        loading.innerHTML =
            "❌ Text detection failed.";

    }

}


// ---------------- SHOW TEXT LIST ----------------

function showDetectedText() {

    textResults.innerHTML = "";

    if (detectedWords.length === 0) {

        textResults.innerHTML =
            "No readable text found.";

        return;
    }

    detectedWords.forEach((word, index) => {

        const div =
            document.createElement("div");

        div.className = "text-item";

        div.innerHTML =
            `📝 ${word.text}`;

        div.onclick = function() {

            selectText(index);

        };

        textResults.appendChild(div);

    });

}


// ---------------- SELECT TEXT ----------------

function selectText(index) {

    selectedIndex = index;

    document
        .querySelectorAll(".text-item")
        .forEach(item => {

            item.classList.remove("selected");

        });

    document
        .querySelectorAll(".text-item")[index]
        .classList.add("selected");

    const word =
        detectedWords[index];

    word.replaced = true;

    fontSelect.value =
        word.font;

    fontSize.value =
        word.size;

    sizeValue.innerText =
        Math.round(word.size);

    fontColor.value =
        word.color;

    opacity.value =
        word.opacity * 100;

    redraw();

}


// ---------------- FONT CHANGE ----------------

fontSelect.addEventListener(
    "change",
    function() {

        if (selectedIndex < 0) return;

        detectedWords[selectedIndex].font =
            this.value;

        detectedWords[selectedIndex].replaced =
            true;

        redraw();

    }
);


// ---------------- SIZE ----------------

fontSize.addEventListener(
    "input",
    function() {

        sizeValue.innerText =
            this.value;

        if (selectedIndex < 0) return;

        detectedWords[selectedIndex].size =
            Number(this.value);

        detectedWords[selectedIndex].replaced =
            true;

        redraw();

    }
);


// ---------------- COLOR ----------------

fontColor.addEventListener(
    "input",
    function() {

        if (selectedIndex < 0) return;

        detectedWords[selectedIndex].color =
            this.value;

        detectedWords[selectedIndex].replaced =
            true;

        redraw();

    }
);


// ---------------- OPACITY ----------------

opacity.addEventListener(
    "input",
    function() {

        if (selectedIndex < 0) return;

        detectedWords[selectedIndex].opacity =
            Number(this.value) / 100;

        detectedWords[selectedIndex].replaced =
            true;

        redraw();

    }
);


// ---------------- BOLD ----------------

function toggleBold() {

    if (selectedIndex < 0) return;

    bold =
        !detectedWords[selectedIndex].bold;

    detectedWords[selectedIndex].bold =
        bold;

    detectedWords[selectedIndex].replaced =
        true;

    redraw();
}


// ---------------- ITALIC ----------------

function toggleItalic() {

    if (selectedIndex < 0) return;

    italic =
        !detectedWords[selectedIndex].italic;

    detectedWords[selectedIndex].italic =
        italic;

    detectedWords[selectedIndex].replaced =
        true;

    redraw();
}


// ---------------- DRAW REPLACEMENT ----------------

function drawReplacement(word, index) {

    const weight =
        word.bold ? "bold " : "";

    const style =
        word.italic ? "italic " : "";

    ctx.font =
        `${style}${weight}${word.size}px ${word.font}`;

    ctx.fillStyle =
        hexToRgba(
            word.color,
            word.opacity
        );

    /*
       Cover the original text area.
       A semi-transparent rectangle is used
       to make the replacement readable.
    */

    ctx.save();

    ctx.fillStyle =
        "rgba(255,255,255,0.85)";

    ctx.fillRect(
        word.x - 3,
        word.y - 3,
        word.width + 6,
        word.height + 6
    );

    ctx.fillStyle =
        hexToRgba(
            word.color,
            word.opacity
        );

    ctx.fillText(
        word.text,
        word.x,
        word.y + word.size
    );

    ctx.restore();

}


// ---------------- COLOR CONVERSION ----------------

function hexToRgba(hex, alpha) {

    const r =
        parseInt(hex.substring(1,3),16);

    const g =
        parseInt(hex.substring(3,5),16);

    const b =
        parseInt(hex.substring(5,7),16);

    return `rgba(${r},${g},${b},${alpha})`;
}


// ---------------- DRAG TEXT ----------------

canvas.addEventListener(
    "mousedown",
    startDrag
);

canvas.addEventListener(
    "touchstart",
    startDrag,
    {passive:false}
);


function getPosition(event) {

    const rect =
        canvas.getBoundingClientRect();

    let clientX;
    let clientY;

    if (event.touches) {

        clientX =
            event.touches[0].clientX;

        clientY =
            event.touches[0].clientY;

    } else {

        clientX =
            event.clientX;

        clientY =
            event.clientY;
    }

    return {

        x:
            (clientX - rect.left) *
            (canvas.width / rect.width),

        y:
            (clientY - rect.top) *
            (canvas.height / rect.height)

    };

}


function startDrag(event) {

    if (selectedIndex < 0) return;

    event.preventDefault();

    const pos =
        getPosition(event);

    const word =
        detectedWords[selectedIndex];

    if (
        pos.x >= word.x &&
        pos.x <= word.x + word.width &&
        pos.y >= word.y &&
        pos.y <= word.y + word.height
    ) {

        dragging = true;

        dragOffsetX =
            pos.x - word.x;

        dragOffsetY =
            pos.y - word.y;

    }

}


canvas.addEventListener(
    "mousemove",
    dragText
);

canvas.addEventListener(
    "touchmove",
    dragText,
    {passive:false}
);


function dragText(event) {

    if (!dragging) return;

    event.preventDefault();

    const pos =
        getPosition(event);

    const word =
        detectedWords[selectedIndex];

    word.x =
        pos.x - dragOffsetX;

    word.y =
        pos.y - dragOffsetY;

    redraw();

}


window.addEventListener(
    "mouseup",
    () => dragging = false
);

window.addEventListener(
    "touchend",
    () => dragging = false
);


// ---------------- RESET ----------------

function resetImage() {

    detectedWords = [];

    selectedIndex = -1;

    textResults.innerHTML =
        "No text detected yet.";

    loading.innerHTML = "";

    if (originalImage.src) {

        canvas.width =
            originalImage.width;

        canvas.height =
            originalImage.height;

        ctx.drawImage(
            originalImage,
            0,
            0,
            canvas.width,
            canvas.height
        );

    }

}


// ---------------- DOWNLOAD ----------------

function downloadImage() {

    if (!originalImage.src) {

        alert("Please upload an image.");

        return;
    }

    const link =
        document.createElement("a");

    link.download =
        "edited-image.png";

    link.href =
        canvas.toDataURL("image/png");

    link.click();

}

</script>

</body>
</html>
