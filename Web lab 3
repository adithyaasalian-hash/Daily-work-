<!DOCTYPE html>

<html>

<head>

<style>

body{font-family:Arial;background:#f4f4f4}

form{width:450px;margin:30px auto;padding:20px;background:white}

h2{text-align:center}

h3{background:#0a3;color:white;padding:8px}

.row{display:flex;margin:10px 0}

label{width:110px}

input,select,textarea{flex:1;padding:6px}

button{background:#0a3;color:white;border:0;padding:8px 15px;margin:10px 5px}

</style>

</head>

<body>

<form>

<h2>Registration Form</h2>

<h3>Personal Information</h3>

<div class="row"><label>First Name:</label>

<textarea placeholder="Enter your First name"></textarea></div>

<div class="row"><label>Last Name:</label>

 <textarea placeholder="Enter your last name"></textarea></div>

<div class="row"><label>Email:</label><textarea placeholder="Enter your gmail"></textarea></div>

<div class="row"><label>Password:</label><textarea placeholder="Enter your password"></textarea></div>

<div class="row"><label>Gender:</label>

<input type="radio" name="g"> Male

<input type="radio" name="g"> Female

</div>

<div class="row"><label>Country:</label>

<select><option>India</option><option>USA</option><option>UK</option></select>

</div>

<div class="row"><label>Hobbies:</label>

<input type="checkbox"> Reading

<input type="checkbox"> Sports

 

<input type="checkbox">dance 

</div>

<div class="row"><label>Address:</label>

<textarea placeholder="Enter your address"></textarea></div>

<center>

<button type="submit">Register</button>

<button type="reset">Reset</button>

</center>

</form>

</body>

</html>

