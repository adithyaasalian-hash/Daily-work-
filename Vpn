<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My VPN</title>

<style>
* {
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    margin: 0;
    min-height: 100vh;
    background: linear-gradient(135deg,#07111f,#101d35);
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
}

.container {
    width: 360px;
    padding: 25px;
    border-radius: 25px;
    background: rgba(255,255,255,.08);
    backdrop-filter: blur(15px);
    box-shadow: 0 20px 50px rgba(0,0,0,.4);
}

h1 {
    text-align: center;
    margin-bottom: 5px;
}

.subtitle {
    text-align: center;
    color: #9da9bb;
    margin-bottom: 25px;
}

.vpn-circle {
    width: 190px;
    height: 190px;
    margin: auto;
    border-radius: 50%;
    border: 8px solid #263754;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.vpn-circle.connected {
    border-color: #00e676;
    box-shadow: 0 0 35px rgba(0,230,118,.4);
}

.lock {
    font-size: 45px;
}

.status {
    margin-top: 8px;
    font-size: 18px;
    font-weight: bold;
}

.timer {
    margin-top: 5px;
    color: #aaa;
}

button {
    width: 100%;
    padding: 15px;
    border: none;
    border-radius: 12px;
    margin-top: 25px;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
    background: #00e676;
    color: #06140d;
}

button.disconnect {
    background: #ff5252;
    color: white;
}

select {
    width: 100%;
    padding: 13px;
    margin-top: 20px;
    border-radius: 10px;
    background: #17243b;
    color: white;
    border: 1px solid #33445f;
}

.info {
    margin-top: 20px;
    padding: 15px;
    background: rgba(255,255,255,.05);
    border-radius: 12px;
}

.row {
    display: flex;
    justify-content: space-between;
    margin: 10px 0;
    color: #c5cedc;
}

.value {
    color: white;
    font-weight: bold;
}
</style>
</head>

<body>

<div class="container">

    <h1>🛡️ My VPN</h1>
    <div class="subtitle">Private connection dashboard</div>

    <div id="circle" class="vpn-circle">
        <div class="lock">🔒</div>
        <div id="status" class="status">Disconnected</div>
        <div id="timer" class="timer">00:00:00</div>
    </div>

    <select id="server">
        <option>🇮🇳 India - Mumbai</option>
        <option>🇮🇳 India - Bengaluru</option>
        <option>🇸🇬 Singapore</option>
        <option>🇯🇵 Japan</option>
        <option>🇩🇪 Germany</option>
        <option>🇺🇸 United States</option>
        <option>🇬🇧 United Kingdom</option>
    </select>

    <button id="connectBtn" onclick="toggleVPN()">
        CONNECT
    </button>

    <div class="info">
        <div class="row">
            <span>🌐 IP Address</span>
            <span class="value" id="ip">--.--.--.--</span>
        </div>

        <div class="row">
            <span>📍 Server</span>
            <span class="value" id="serverName">None</span>
        </div>

        <div class="row">
            <span>⬇️ Download</span>
            <span class="value" id="download">0 MB</span>
        </div>

        <div class="row">
            <span>⬆️ Upload</span>
            <span class="value" id="upload">0 MB</span>
        </div>
    </div>

</div>

<script>

let connected = false;
let seconds = 0;
let interval;

function randomIP() {
    return Math.floor(Math.random()*223 + 1) + "." +
           Math.floor(Math.random()*256) + "." +
           Math.floor(Math.random()*256) + "." +
           Math.floor(Math.random()*256);
}

function formatTime(sec) {
    let h = Math.floor(sec / 3600);
    let m = Math.floor((sec % 3600) / 60);
    let s = sec % 60;

    return String(h).padStart(2,'0') + ":" +
           String(m).padStart(2,'0') + ":" +
           String(s).padStart(2,'0');
}

function toggleVPN() {

    const circle = document.getElementById("circle");
    const status = document.getElementById("status");
    const button = document.getElementById("connectBtn");
    const server = document.getElementById("server");
    const ip = document.getElementById("ip");
    const serverName = document.getElementById("serverName");

    if (!connected) {

        connected = true;
        seconds = 0;

        circle.classList.add("connected");
        status.textContent = "Connected";
        button.textContent = "DISCONNECT";
        button.classList.add("disconnect");

        ip.textContent = randomIP();
        serverName.textContent = server.value;

        interval = setInterval(() => {

            seconds++;

            document.getElementById("timer").textContent =
                formatTime(seconds);

            document.getElementById("download").textContent =
                (seconds * 0.37).toFixed(1) + " MB";

            document.getElementById("upload").textContent =
                (seconds * 0.12).toFixed(1) + " MB";

        },1000);

    } else {

        connected = false;

        clearInterval(interval);

        circle.classList.remove("connected");
        status.textContent = "Disconnected";

        button.textContent = "CONNECT";
        button.classList.remove("disconnect");

        ip.textContent = "--.--.--.--";
        serverName.textContent = "None";

    }
}

</script>

</body>
</html>
