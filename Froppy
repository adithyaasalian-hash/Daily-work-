<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Frogger Game</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #111;
        color: white;
        font-family: Arial, sans-serif;
        text-align: center;
        overflow: hidden;
    }

    h1 {
        margin: 10px 0 5px;
    }

    #score {
        font-size: 20px;
        margin-bottom: 8px;
    }

    canvas {
        background: #333;
        border: 3px solid white;
        max-width: 95vw;
        max-height: 75vh;
    }

    button {
        margin-top: 10px;
        padding: 10px 25px;
        font-size: 18px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }
</style>
</head>

<body>

<h1>🐸 FROGGER</h1>
<div id="score">Score: 0 | Lives: 3</div>

<canvas id="game" width="600" height="700"></canvas>

<br>
<button onclick="restartGame()">Restart Game</button>

<script>

const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

const frog = {
    x: 280,
    y: 640,
    size: 30,
    speed: 50
};

let score = 0;
let lives = 3;
let gameOver = false;

// Cars
let cars = [
    {x: 0,   y: 550, w: 80, h: 35, speed: 3, color: "red"},
    {x: 250, y: 550, w: 80, h: 35, speed: 3, color: "red"},

    {x: 100, y: 450, w: 90, h: 35, speed: -4, color: "blue"},
    {x: 400, y: 450, w: 90, h: 35, speed: -4, color: "blue"},

    {x: 50,  y: 350, w: 70, h: 35, speed: 5, color: "orange"},
    {x: 300, y: 350, w: 70, h: 35, speed: 5, color: "orange"},

    {x: 150, y: 250, w: 100, h: 35, speed: -3, color: "purple"},
    {x: 450, y: 250, w: 100, h: 35, speed: -3, color: "purple"}
];

// Keyboard controls
document.addEventListener("keydown", function(e) {

    if (gameOver) return;

    if (e.key === "ArrowUp") {
        frog.y -= frog.speed;
    }

    if (e.key === "ArrowDown") {
        frog.y += frog.speed;
    }

    if (e.key === "ArrowLeft") {
        frog.x -= frog.speed;
    }

    if (e.key === "ArrowRight") {
        frog.x += frog.speed;
    }

    // Keep frog inside screen
    frog.x = Math.max(0, Math.min(canvas.width - frog.size, frog.x));
    frog.y = Math.max(0, Math.min(canvas.height - frog.size, frog.y));
});

// Draw frog
function drawFrog() {

    ctx.font = "32px Arial";
    ctx.fillText("🐸", frog.x, frog.y + 30);
}

// Draw cars
function drawCars() {

    cars.forEach(car => {

        ctx.fillStyle = car.color;
        ctx.fillRect(car.x, car.y, car.w, car.h);

        // Windows
        ctx.fillStyle = "lightblue";
        ctx.fillRect(car.x + 15, car.y + 5, 20, 12);
        ctx.fillRect(car.x + car.w - 35, car.y + 5, 20, 12);

        // Wheels
        ctx.fillStyle = "black";
        ctx.beginPath();
        ctx.arc(car.x + 15, car.y + car.h, 8, 0, Math.PI * 2);
        ctx.fill();

        ctx.beginPath();
        ctx.arc(car.x + car.w - 15, car.y + car.h, 8, 0, Math.PI * 2);
        ctx.fill();
    });
}

// Move cars
function moveCars() {

    cars.forEach(car => {

        car.x += car.speed;

        if (car.speed > 0 && car.x > canvas.width) {
            car.x = -car.w;
        }

        if (car.speed < 0 && car.x + car.w < 0) {
            car.x = canvas.width;
        }
    });
}

// Collision detection
function collision(car) {

    return (
        frog.x < car.x + car.w &&
        frog.x + frog.size > car.x &&
        frog.y < car.y + car.h &&
        frog.y + frog.size > car.y
    );
}

// Check collisions
function checkCollision() {

    cars.forEach(car => {

        if (collision(car)) {

            lives--;

            frog.x = 280;
            frog.y = 640;

            if (lives <= 0) {
                gameOver = true;
            }
        }
    });
}

// Check if frog reaches top
function checkWin() {

    if (frog.y <= 30) {

        score += 100;

        frog.x = 280;
        frog.y = 640;
    }
}

// Draw road
function drawBackground() {

    // Grass
    ctx.fillStyle = "#238b45";
    ctx.fillRect(0, 0, canvas.width, 150);

    ctx.fillStyle = "#238b45";
    ctx.fillRect(0, 600, canvas.width, 100);

    // Road
    ctx.fillStyle = "#444";
    ctx.fillRect(0, 150, canvas.width, 450);

    // Road lines
    ctx.strokeStyle = "white";
    ctx.setLineDash([30, 30]);
    ctx.lineWidth = 4;

    for (let y = 200; y < 600; y += 100) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvas.width, y);
        ctx.stroke();
    }

    ctx.setLineDash([]);

    // Goal
    ctx.fillStyle = "#1db954";
    ctx.font = "bold 25px Arial";
    ctx.fillText("🏆 GOAL!", 250, 80);
}

// Update score display
function updateScore() {

    document.getElementById("score").innerText =
        "Score: " + score + " | Lives: " + lives;
}

// Game loop
function gameLoop() {

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    drawBackground();
    moveCars();
    drawCars();
    drawFrog();

    checkCollision();
    checkWin();
    updateScore();

    if (gameOver) {

        ctx.fillStyle = "rgba(0,0,0,0.75)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = "white";
        ctx.font = "45px Arial";
        ctx.fillText("GAME OVER", 170, 330);

        ctx.font = "25px Arial";
        ctx.fillText("Score: " + score, 240, 380);

    } else {

        requestAnimationFrame(gameLoop);
    }
}

// Restart
function restartGame() {

    score = 0;
    lives = 3;
    gameOver = false;

    frog.x = 280;
    frog.y = 640;

    gameLoop();
}

gameLoop();

</script>

</body>
</html>
