<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>FF & COC Account Rate Predictor</title>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,Helvetica,sans-serif;
    background:#080711;
    color:white;
}

body::before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    background:
    radial-gradient(circle at 80% 10%,rgba(124,60,255,.3),transparent 30%),
    radial-gradient(circle at 10% 90%,rgba(255,204,25,.12),transparent 30%);
}

header{
    height:70px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 6%;
    background:rgba(8,7,17,.9);
    border-bottom:1px solid #332a4d;
    position:relative;
    z-index:5;
}

.logo{
    font-size:25px;
    font-weight:900;
    font-style:italic;
}

.logo span{
    color:#ffcc19;
}

.badge{
    border:1px solid #59457b;
    padding:8px 14px;
    border-radius:30px;
    font-size:11px;
    color:#ddd0ff;
}

main{
    max-width:1200px;
    margin:auto;
    padding:45px 20px 60px;
    position:relative;
}

.hero{
    text-align:center;
    margin-bottom:35px;
}

.eyebrow{
    color:#ffcc19;
    font-size:12px;
    font-weight:bold;
    letter-spacing:3px;
}

.hero h1{
    font-size:clamp(40px,7vw,75px);
    margin:12px 0;
    font-style:italic;
    font-weight:1000;
}

.hero h1 span{
    color:#ffcc19;
}

.hero p{
    color:#aaa4bb;
    max-width:650px;
    margin:auto;
    line-height:1.6;
}

.layout{
    display:grid;
    grid-template-columns:450px 1fr;
    gap:22px;
}

.card{
    background:linear-gradient(
        145deg,
        #191525,
        #0c0a13
    );
    border:1px solid #332a4d;
    border-radius:20px;
    box-shadow:0 20px 50px rgba(0,0,0,.4);
}

.form{
    padding:25px;
}

.game-switch{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-bottom:20px;
}

.game-switch button{
    margin:0;
    padding:12px 5px;
    border-radius:10px;
    border:1px solid #40355d;
    background:#171322;
    color:#ddd6ef;
    cursor:pointer;
    font-weight:bold;
}

.game-switch button.active{
    background:#7c3cff;
    color:white;
    border-color:#7c3cff;
}

.card-title{
    margin:0 0 20px;
}

.card-title span{
    color:#ffcc19;
}

.field{
    margin:15px 0;
}

.field label{
    display:flex;
    justify-content:space-between;
    margin-bottom:8px;
    font-size:13px;
    font-weight:bold;
    color:#d8d1e7;
}

.value{
    color:#ffcc19;
}

select,
input{
    width:100%;
    padding:13px;
    border-radius:10px;
    border:1px solid #40355d;
    background:#0d0b16;
    color:white;
    outline:none;
    font-size:14px;
}

select:focus,
input:focus{
    border-color:#7c3cff;
    box-shadow:0 0 0 3px rgba(124,60,255,.15);
}

input[type="range"]{
    padding:0;
    accent-color:#7c3cff;
}

button.predict{
    width:100%;
    padding:15px;
    margin-top:12px;
    border:0;
    border-radius:12px;
    background:linear-gradient(
        90deg,
        #ffcc19,
        #ff9919
    );
    color:#17120a;
    font-size:16px;
    font-weight:1000;
    cursor:pointer;
}

button.predict:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 30px rgba(255,180,20,.3);
}

.result{
    padding:28px;
    min-height:620px;
}

.result-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.result-head h2{
    margin:0;
}

.status{
    font-size:10px;
    color:#38e58b;
    border:1px solid rgba(56,229,139,.4);
    padding:7px 10px;
    border-radius:20px;
}

.pricebox{
    margin-top:20px;
    text-align:center;
    padding:30px 15px;
    border-radius:18px;
    border:1px solid #5d4422;
    background:#0d0b14;
}

.price-label{
    color:#d8d1e7;
    font-weight:bold;
}

.price{
    font-size:clamp(40px,6vw,68px);
    color:#ffcc19;
    font-weight:1000;
    margin:8px 0;
}

.note{
    color:#888191;
    font-size:11px;
}

.stats{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
    margin-top:15px;
}

.stat{
    padding:17px;
    background:#0e0c17;
    border:1px solid #332a4d;
    border-radius:14px;
}

.stat b{
    font-size:23px;
}

.stat small{
    display:block;
    color:#9991a8;
    margin-top:5px;
}

.meter{
    height:8px;
    background:#292238;
    border-radius:20px;
    overflow:hidden;
    margin-top:10px;
}

.meter i{
    display:block;
    height:100%;
    width:0%;
    background:linear-gradient(
        90deg,
        #7c3cff,
        #ffcc19
    );
    transition:.7s;
}

.insights{
    margin-top:18px;
    display:grid;
    gap:10px;
}

.insight{
    font-size:13px;
    color:#d9d3e6;
}

.insight::before{
    content:"✓";
    display:inline-grid;
    place-items:center;
    width:20px;
    height:20px;
    margin-right:8px;
    border-radius:50%;
    color:#38e58b;
    background:rgba(56,229,139,.1);
}

.warning{
    margin-top:20px;
    padding:12px;
    border:1px solid #3c324f;
    border-radius:10px;
    color:#9991a8;
    font-size:11px;
    line-height:1.5;
}

footer{
    text-align:center;
    color:#777083;
    font-size:11px;
    margin-top:25px;
}

@media(max-width:850px){

    .layout{
        grid-template-columns:1fr;
    }

    nav{
        display:none;
    }

    .result{
        min-height:auto;
    }

}

</style>
</head>

