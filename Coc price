/* =====================================================
   HELPER
===================================================== */

function number(id){

    return Number(
        document.getElementById(id).value
    );

}


/* =====================================================
   FREE FIRE SETUP
===================================================== */

function setupFF(){

    const collection =
        document.getElementById(
            "ffCollection"
        );

    const collectionValue =
        document.getElementById(
            "ffCollectionValue"
        );

    const collectionBar =
        document.getElementById(
            "ffCollectionBar"
        );


    collection.oninput =
    function(){

        collectionValue.textContent =
            this.value + "%";

        collectionBar.style.width =
            this.value + "%";

    };


    collection.oninput();


    document.getElementById(
        "ffPredict"
    ).onclick =
    predictFF;


    predictFF();

}


/* =====================================================
   FREE FIRE PREDICTION
===================================================== */

function predictFF(){

    const total =
        number("ffLevel") +
        number("ffDiamonds") +
        number("ffBundles") +
        number("ffGuns") +
        number("ffCharacters") +
        number("ffOld") +
        number("ffAge") +
        number("ffRank");


    const collection =
        number("ffCollection");


    let score =
        Math.round(
            (total / 32) * 72 +
            collection * .28
        );


    score =
        Math.max(
            18,
            Math.min(100,score)
        );


    const base =
        900 +
        score * 55;


    const low =
        Math.round(
            (base * .72) / 100
        ) * 100;


    const high =
        Math.round(
            (base * 1.42) / 100
        ) * 100;


    showResult(
        score,
        low,
        high
    );


    let insights=[];


    if(number("ffBundles")>=3){

        insights.push(
            "Rare bundles can strongly increase collector appeal."
        );

    }


    if(number("ffGuns")>=3){

        insights.push(
            "Evo and gun-skin collection increases account demand."
        );

    }


    if(number("ffOld")>=3){

        insights.push(
            "Old or limited items can create a collector premium."
        );

    }


    if(collection>=80){

        insights.push(
            "High collection coverage makes the account more attractive."
        );

    }


    if(number("ffRank")>=3){

        insights.push(
            "Heroic/Grandmaster history adds prestige."
        );

    }


    if(insights.length===0){

        insights.push(
            "More rare items and higher collection can improve the estimate."
        );

    }


    showInsights(insights);

}


