/* =====================================================
   COC PREDICTION
===================================================== */

function predictCOC(){

    const total =
        number("cocTH") +
        number("cocHeroes") +
        number("cocWalls") +
        number("cocWar") +
        number("cocSkins") +
        number("cocMagic") +
        number("cocAge") +
        number("cocPets");


    const collection =
        number("cocCollection");


    let score =
        Math.round(
            (total / 56) * 75 +
            collection * .25
        );


    score =
        Math.max(
            18,
            Math.min(100,score)
        );


    const base =
        1000 +
        score * 105;


    const low =
        Math.round(
            (base * .72) / 100
        ) * 100;


    const high =
        Math.round(
            (base * 1.45) / 100
        ) * 100;


    showResult(
        score,
        low,
        high
    );


    let insights=[];


    if(number("cocTH")>=5){

        insights.push(
            "High Town Hall progression is a major value factor."
        );

    }


    if(number("cocHeroes")>=3){

        insights.push(
            "Strong hero levels increase account progression value."
        );

    }


    if(number("cocSkins")>=3){

        insights.push(
            "Rare skins and decorations can increase collector demand."
        );

    }


    if(number("cocAge")>=3){

        insights.push(
            "Older accounts may have additional collector appeal."
        );
