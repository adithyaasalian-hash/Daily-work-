<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Timetable Maker</title>

<style>
* {
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    margin: 0;
    background: #f3f5f9;
    color: #222;
}

header {
    background: linear-gradient(135deg, #182848, #4b6cb7);
    color: white;
    text-align: center;
    padding: 25px 15px;
}

header h1 {
    margin: 0;
    font-size: 28px;
}

header p {
    margin: 7px 0 0;
}

.container {
    max-width: 1200px;
    margin: auto;
    padding: 20px;
}

/* FORM */

.form-box {
    background: white;
    padding: 20px;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,.08);
    margin-bottom: 20px;
}

.form-box h2 {
    margin-top: 0;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

input,
select {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 15px;
}

button {
    border: none;
    padding: 11px 17px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
}

.add-btn {
    background: #4b6cb7;
    color: white;
    margin-top: 12px;
}

.clear-btn {
    background: #e74c3c;
    color: white;
    margin-top: 12px;
    margin-left: 8px;
}

/* TIMETABLE */

.table-container {
    overflow-x: auto;
    background: white;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,.08);
}

table {
    width: 100%;
    min-width: 900px;
    border-collapse: collapse;
}

th {
    background: #182848;
    color: white;
    padding: 15px;
}

td {
    border: 1px solid #ddd;
    padding: 8px;
    text-align: center;
    min-width: 130px;
    height: 85px;
}

.time {
    background: #eef1f6;
    font-weight: bold;
}

.class-box {
    background: #e9f0ff;
    border-radius: 10px;
    padding: 8px;
    min-height: 60px;
}

.class-box strong {
    display: block;
    font-size: 14px;
}

.class-box small {
    display: block;
    margin-top: 4px;
    color: #555;
}

.actions {
    margin-top: 7px;
}

.actions button {
    padding: 5px 7px;
    font-size: 11px;
}

.edit {
    background: #f39c12;
    color: white;
}

.delete {
    background: #e74c3c;
    color: white;
}

/* MOBILE */

@media(max-width:700px) {

    .form-grid {
        grid-template-columns: 1fr;
    }

    header h1 {
        font-size: 23px;
    }

}
</style>
</head>

<body>

<header>
    <h1>📅 My Timetable Maker</h1>
    <p>Create and manage your weekly college timetable</p>
</header>

<div class="container">

    <!-- ADD CLASS -->

    <div class="form-box">

        <h2>➕ Add Class</h2>

        <div class="form-grid">

            <select id="day">
                <option value="">Select Day</option>
                <option>Monday</option>
                <option>Tuesday</option>
                <option>Wednesday</option>
                <option>Thursday</option>
                <option>Friday</option>
                <option>Saturday</option>
            </select>

            <select id="time">
                <option value="">Select Time</option>
                <option>9:00 - 9:55</option>
                <option>9:55 - 10:50</option>
                <option>11:00 - 11:55</option>
                <option>11:55 - 12:50</option>
                <option>1:00 - 1:55</option>
                <option>1:55 - 2:50</option>
                <option>3:00 - 3:55</option>
                <option>3:55 - 4:50</option>
            </select>

            <input
                id="subject"
                type="text"
                placeholder="Subject / Class"
            >

            <input
                id="room"
                type="text"
                placeholder="Room / Lab (optional)"
            >

        </div>

        <button
            class="add-btn"
            onclick="addClass()">
            ➕ Add Class
        </button>

        <button
            class="clear-btn"
            onclick="clearTimetable()">
            🗑️ Clear All
        </button>

    </div>


    <!-- TIMETABLE -->

    <div class="table-container">

        <table>

            <thead>

                <tr>
                    <th>Time</th>
                    <th>Monday</th>
                    <th>Tuesday</th>
                    <th>Wednesday</th>
                    <th>Thursday</th>
                    <th>Friday</th>
                    <th>Saturday</th>
                </tr>

            </thead>

            <tbody id="timetable"></tbody>

        </table>

    </div>

</div>


<script>

const days = [
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday"
];

const times = [
    "9:00 - 9:55",
    "9:55 - 10:50",
    "11:00 - 11:55",
    "11:55 - 12:50",
    "1:00 - 1:55",
    "1:55 - 2:50",
    "3:00 - 3:55",
    "3:55 - 4:50"
];


let classes =
    JSON.parse(
        localStorage.getItem("myTimetable")
    ) || [];


function save() {

    localStorage.setItem(
        "myTimetable",
        JSON.stringify(classes)
    );

}


function addClass() {

    const day =
        document.getElementById("day").value;

    const time =
        document.getElementById("time").value;

    const subject =
        document.getElementById("subject").value.trim();

    const room =
        document.getElementById("room").value.trim();


    if (!day || !time || !subject) {

        alert(
            "Please select day, time and subject."
        );

        return;
    }


    classes.push({

        id: Date.now(),

        day: day,

        time: time,

        subject: subject,

        room: room

    });


    save();

    document.getElementById("subject").value = "";
    document.getElementById("room").value = "";

    display();

}


function deleteClass(id) {

    classes =
        classes.filter(
            item => item.id !== id
        );

    save();

    display();

}


function editClass(id) {

    const item =
        classes.find(
            item => item.id === id
        );

    if (!item) return;


    const newSubject =
        prompt(
            "Enter subject name:",
            item.subject
        );

    if (newSubject === null) return;


    const newRoom =
        prompt(
            "Enter room/lab:",
            item.room
        );


    item.subject =
        newSubject.trim();

    item.room =
        newRoom ? newRoom.trim() : "";


    save();

    display();

}


function clearTimetable() {

    if (
        !confirm(
            "Are you sure you want to clear the entire timetable?"
        )
    ) return;


    classes = [];

    save();

    display();

}


function getClass(day, time) {

    return classes.filter(
        item =>
            item.day === day &&
            item.time === time
    );

}


function display() {

    const tbody =
        document.getElementById("timetable");

    tbody.innerHTML = "";


    times.forEach(time => {

        const row =
            document.createElement("tr");


        let html =
            `<td class="time">${time}</td>`;


        days.forEach(day => {

            const dayClasses =
                getClass(day, time);


            html += "<td>";


            dayClasses.forEach(item => {

                html += `

                <div class="class-box">

                    <strong>
                        ${item.subject}
                    </strong>

                    ${
                        item.room
                        ? `<small>📍 ${item.room}</small>`
                        : ""
                    }

                    <div class="actions">

                        <button
                            class="edit"
                            onclick="editClass(${item.id})">
                            Edit
                        </button>

                        <button
                            class="delete"
                            onclick="deleteClass(${item.id})">
                            Delete
                        </button>

                    </div>

                </div>

                `;

            });


            html += "</td>";

        });


        row.innerHTML = html;

        tbody.appendChild(row);

    });

}


display();

</script>

</body>
</html>
