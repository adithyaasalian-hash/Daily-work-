<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mass Determination - Balance Scale</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #16222a, #3a6073);
    color: white;
    text-align: center;
}

h1 {
    margin: 15px 0 5px;
}

.info {
    font-size: 18px;
    margin: 8px;
}

.game {
    width: 95%;
    max-width: 800px;
    margin: auto;
}

/* Scale */

.scale {
    position: relative;
    height: 330px;
    margin-top: 20px;
}

.beam {
    position: absolute;
    top: 100px;
    left: 10%;
    width: 80%;
    height: 12px;
    background: #ddd;
    border-radius: 10px;
    transform-origin: center;
    transition: transform 0.4s;
}

.pivot {
    position: absolute;
    top: 105px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 35px solid transparent;
    border-right: 35px solid transparent;
    border-bottom: 70px solid #777;
}

.pan {
    position: absolute;
    top: 125px;
    width: 180px;
    min-height: 100px;
    background: #aaa;
    border: 4px solid #ddd;
    border-radius: 0 0 80px 80px;
    padding: 15px;
}

.left-pan {
    left: 5%;
}

.right-pan {
    right: 5%;
}

.pan-title {
    font-weight: bold;
    margin-bottom: 8px;
}

.item {
    font-size: 42px;
}

/* Weights */

.weights {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 10px auto;
}

.weight {
    width: 65px;
    height: 65px;
    border-radius: 50%;
    background: #f0b429;
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    cursor: grab;
    border: 4px solid #ffe08a;
    user-select: none;
}

.weight:active {
    cursor: grabbing;
}

button {
    padding: 12px 25px;
    margin: 8px;
    border: none;
    border-radius: 10px;
    font-size: 17px;
    cursor: pointer;
}

#check {
    background: #20c997;
    color: white;
}

#reset {
    background: #ff6b6b;
    color: white;
}

.message {
    font-size: 22px;
    font-weight: bold;
    min-height: 35px;
}

.score {
    font-size: 20px;
}
</style>
</head>

<body>

<div class="game">

<h1>⚖️ Mass Determination</h1>

<div class="info">
    Find the mass of the mystery object!
</div>

<div class="score">
    Score: <span id="score">0</span>
    &nbsp; | &nbsp;
    Level: <span id="level">1</span>
</div>

<div class="scale">

    <div class="beam" id="beam"></div>

    <div class="pivot"></div>

    <div class="pan left-pan" id="leftPan">
        <div class="pan-title">MYSTERY OBJECT</div>
        <div class="item">📦</div>
    </div>

    <div class="pan right-pan" id="rightPan">
        <div class="pan-title">WEIGHTS</div>
        <div id="placedWeights">0 g</div>
    </div>

</div>

<h2>Drag weights onto the right pan</h2>

<div class="weights" id="weights"></div>

<div>
    <button id="check">⚖️ Check Balance</button>
    <button id="reset">🔄 Reset</button>
</div>

<div class="message" id="message"></div>

</div>

<script>

let score = 0;
let level = 1;
let targetMass = 100;

let selectedMass = 0;

const weightValues = [10, 20, 50, 100, 200];

const weightsContainer = document.getElementById("weights");
const placedWeights = document.getElementById("placedWeights");
const beam = document.getElementById("beam");
const message = document.getElementById("message");
const scoreText = document.getElementById("score");
const levelText = document.getElementById("level");

const rightPan = document.getElementById("rightPan");

// Create weights
function createWeights() {

    weightsContainer.innerHTML = "";

    weightValues.forEach(value => {

        const weight = document.createElement("div");

        weight.className = "weight";
        weight.textContent = value + "g";
        weight.draggable = true;
        weight.dataset.mass = value;

        weight.addEventListener("dragstart", dragStart);

        weightsContainer.appendChild(weight);
    });
}

function dragStart(e) {
    e.dataTransfer.setData("mass", e.target.dataset.mass);
}

// Allow dropping
rightPan.addEventListener("dragover", function(e) {
    e.preventDefault();
});

rightPan.addEventListener("drop", function(e) {

    e.preventDefault();

    const mass = Number(e.dataTransfer.getData("mass"));

    selectedMass += mass;

    updateScale();
});

// Update scale
function updateScale() {

    placedWeights.textContent = selectedMass + " g";

    // Tilt beam
    const difference = selectedMass - targetMass;

    let angle = difference * 0.08;

    angle = Math.max(-12, Math.min(12, angle));

    beam.style.transform = `rotate(${angle}deg)`;
}

// Check answer
document.getElementById("check").addEventListener("click", function() {

    if (selectedMass === targetMass) {

        score += 100;
        level++;

        message.textContent =
            "🎉 Correct! The mass is " + targetMass + " g.";

        message.style.color = "#7CFC00";

        targetMass = generateMass();

        levelText.textContent = level;
        scoreText.textContent = score;

        setTimeout(() => {

            selectedMass = 0;
            message.textContent = "";
            updateScale();

        }, 1500);

    } else if (selectedMass < targetMass) {

        message.textContent = "⬆️ Add more weight!";

        message.style.color = "#ffd166";

    } else {

        message.textContent = "⬇️ Remove some weight!";

        message.style.color = "#ff6b6b";
    }
});

// Reset current attempt
document.getElementById("reset").addEventListener("click", function() {

    selectedMass = 0;

    message.textContent = "";

    updateScale();
});

// Generate random target mass
function generateMass() {

    const masses = [
        50,
        80,
        100,
        120,
        150,
        180,
        200,
        250,
        300,
        350
    ];

    return masses[Math.floor(Math.random() * masses.length)];
}

// Start game
createWeights();
updateScale();

</script>

</body>
</html>
