<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Temple Run Mini</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    overflow: hidden;
    background: #111;
    font-family: Arial, sans-serif;
}

#game {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background: linear-gradient(#72c7e8 0%, #d5efb5 35%, #4d8b38 100%);
}

/* Ground */
#road {
    position: absolute;
    width: 70%;
    height: 120%;
    left: 15%;
    top: 0;
    background: #a87943;
    clip-path: polygon(35% 0, 65% 0, 100% 100%, 0 100%);
}

/* Side trees */
.tree {
    position: absolute;
    font-size: 55px;
    z-index: 2;
}

.t1 { left: 3%; top: 25%; }
.t2 { right: 4%; top: 18%; }
.t3 { left: 7%; top: 65%; }
.t4 { right: 8%; top: 60%; }

/* Player */
#player {
    position: absolute;
    width: 55px;
    height: 70px;
    bottom: 90px;
    left: calc(50% - 27px);
    z-index: 10;
    transition: left 0.15s;
}

.head {
    width: 25px;
    height: 25px;
    background: #f0b27a;
    border-radius: 50%;
    margin: auto;
}

.body {
    width: 30px;
    height: 35px;
    background: #e74c3c;
    margin: 2px auto;
    border-radius: 8px;
}

.leg {
    position: absolute;
    width: 10px;
    height: 22px;
    background: #273746;
    bottom: 0;
}

.leg.left {
    left: 15px;
}

.leg.right {
    right: 15px;
}

/* Coins and obstacles */
.coin,
.obstacle {
    position: absolute;
    z-index: 8;
}

.coin {
    width: 25px;
    height: 25px;
    border-radius: 50%;
    background: gold;
    border: 4px solid #f5b041;
    box-shadow: 0 0 10px yellow;
}

.obstacle {
    width: 45px;
    height: 45px;
    background: #5b2c06;
    border-radius: 8px;
}

/* UI */
#score {
    position: absolute;
    top: 20px;
    left: 20px;
    color: white;
    font-size: 24px;
    font-weight: bold;
    z-index: 20;
}

#coins {
    position: absolute;
    top: 55px;
    left: 20px;
    color: gold;
    font-size: 20px;
    z-index: 20;
}

#gameOver {
    display: none;
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.75);
    z-index: 50;
    color: white;
    text-align: center;
    padding-top: 25vh;
}

#gameOver h1 {
    font-size: 45px;
    margin-bottom: 15px;
}

button {
    padding: 14px 28px;
    font-size: 20px;
    border: none;
    border-radius: 10px;
    background: #f39c12;
    color: white;
    cursor: pointer;
}

/* Mobile controls */
.controls {
    position: absolute;
    bottom: 15px;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 15px;
    z-index: 30;
}

.controls button {
    width: 70px;
    height: 55px;
    padding: 0;
    background: rgba(0,0,0,0.6);
}
</style>
</head>

<body>

<div id="game">

    <div id="road"></div>

    <div class="tree t1">🌴</div>
    <div class="tree t2">🌴</div>
    <div class="tree t3">🌴</div>
    <div class="tree t4">🌴</div>

    <div id="score">Score: 0</div>
    <div id="coins">Coins: 0</div>

    <div id="player">
        <div class="head"></div>
        <div class="body"></div>
        <div class="leg left"></div>
        <div class="leg right"></div>
    </div>

    <div id="gameOver">
        <h1>GAME OVER</h1>
        <p id="finalScore"></p>
        <br>
        <button onclick="restart()">Restart</button>
    </div>

    <div class="controls">
        <button onclick="moveLeft()">⬅</button>
        <button onclick="jump()">⬆</button>
        <button onclick="moveRight()">➡</button>
    </div>

</div>

<script>

const player = document.getElementById("player");
const game = document.getElementById("game");

let lane = 1;
let score = 0;
let coinCount = 0;
let speed = 6;
let jumping = false;
let gameRunning = true;

const lanes = ["35%", "50%", "65%"];

/* Move player */
function updatePlayer() {
    player.style.left = `calc(${lanes[lane]} - 27px)`;
}

function moveLeft() {
    if (lane > 0 && gameRunning) {
        lane--;
        updatePlayer();
    }
}

function moveRight() {
    if (lane < 2 && gameRunning) {
        lane++;
        updatePlayer();
    }
}

/* Jump */
function jump() {

    if (jumping || !gameRunning) return;

    jumping = true;

    player.style.bottom = "220px";

    setTimeout(() => {
        player.style.bottom = "90px";
        jumping = false;
    }, 600);
}

/* Keyboard controls */
document.addEventListener("keydown", function(e) {

    if (e.key === "ArrowLeft" || e.key === "a")
        moveLeft();

    if (e.key === "ArrowRight" || e.key === "d")
        moveRight();

    if (e.key === "ArrowUp" || e.key === " " || e.key === "w")
        jump();
});

/* Create coin */
function createCoin() {

    if (!gameRunning) return;

    const coin = document.createElement("div");
    coin.className = "coin";

    const randomLane = Math.floor(Math.random() * 3);

    coin.style.left = `calc(${lanes[randomLane]} - 12px)`;
    coin.style.top = "-40px";

    game.appendChild(coin);

    let y = -40;

    const move = setInterval(() => {

        if (!gameRunning) {
            clearInterval(move);
            coin.remove();
            return;
        }

        y += speed;
        coin.style.top = y + "px";

        if (checkCollision(coin)) {
            coinCount++;
            document.getElementById("coins").innerText =
                "Coins: " + coinCount;

            clearInterval(move);
            coin.remove();
        }

        if (y > window.innerHeight) {
            clearInterval(move);
            coin.remove();
        }

    }, 30);
}

/* Create obstacle */
function createObstacle() {

    if (!gameRunning) return;

    const obstacle = document.createElement("div");
    obstacle.className = "obstacle";

    const randomLane = Math.floor(Math.random() * 3);

    obstacle.style.left = `calc(${lanes[randomLane]} - 22px)`;
    obstacle.style.top = "-60px";

    game.appendChild(obstacle);

    let y = -60;

    const move = setInterval(() => {

        if (!gameRunning) {
            clearInterval(move);
            obstacle.remove();
            return;
        }

        y += speed;
        obstacle.style.top = y + "px";

        if (checkCollision(obstacle)) {

            if (!jumping) {
                gameOver();
            }

        }

        if (y > window.innerHeight) {
            score += 10;

            document.getElementById("score").innerText =
                "Score: " + score;

            clearInterval(move);
            obstacle.remove();
        }

    }, 30);
}

/* Collision */
function checkCollision(object) {

    const p = player.getBoundingClientRect();
    const o = object.getBoundingClientRect();

    return (
        p.left < o.right &&
        p.right > o.left &&
        p.top < o.bottom &&
        p.bottom > o.top
    );
}

/* Difficulty */
setInterval(() => {

    if (gameRunning) {
        speed += 0.3;
    }

}, 5000);

/* Spawn objects */
setInterval(() => {

    if (gameRunning)
        createObstacle();

}, 1300);

setInterval(() => {

    if (gameRunning)
        createCoin();

}, 800);

/* Game over */
function gameOver() {

    gameRunning = false;

    document.getElementById("finalScore").innerText =
        "Final Score: " + score +
        " | Coins: " + coinCount;

    document.getElementById("gameOver").style.display = "block";
}

/* Restart */
function restart() {

    location.reload();

}

/* Swipe controls */
let startX = 0;
let startY = 0;

game.addEventListener("touchstart", function(e) {

    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;

});

game.addEventListener("touchend", function(e) {

    let endX = e.changedTouches[0].clientX;
    let endY = e.changedTouches[0].clientY;

    let dx = endX - startX;
    let dy = endY - startY;

    if (Math.abs(dx) > Math.abs(dy)) {

        if (dx > 50)
            moveRight();

        if (dx < -50)
            moveLeft();

    } else {

        if (dy < -50)
            jump();

    }

});

updatePlayer();

</script>

</body>
</html>
