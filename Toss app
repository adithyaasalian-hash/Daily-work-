<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Coin Toss 🪙</title>

<style>
    body {
        margin: 0;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #111827, #1f2937);
        color: white;
        text-align: center;
    }

    .container {
        background: #111827;
        padding: 35px;
        border-radius: 25px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.5);
        width: 300px;
    }

    h1 {
        margin-bottom: 25px;
    }

    .coin {
        width: 150px;
        height: 150px;
        margin: 25px auto;
        border-radius: 50%;
        background: radial-gradient(circle, #fff3a0, #d4a017);
        border: 8px solid #f5c542;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 28px;
        font-weight: bold;
        color: #5c4300;
        box-shadow: 0 8px 20px rgba(0,0,0,0.5);
    }

    .flipping {
        animation: flip 1.2s ease-in-out;
    }

    @keyframes flip {
        0% {
            transform: rotateY(0deg) scale(1);
        }
        50% {
            transform: rotateY(900deg) scale(1.15);
        }
        100% {
            transform: rotateY(1800deg) scale(1);
        }
    }

    button {
        border: none;
        padding: 14px 30px;
        border-radius: 30px;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
        background: #f5c542;
        color: #3b2b00;
    }

    button:hover {
        transform: scale(1.05);
    }

    #result {
        margin-top: 20px;
        font-size: 25px;
        font-weight: bold;
    }

    .stats {
        margin-top: 15px;
        font-size: 15px;
        color: #d1d5db;
    }
</style>
</head>

<body>

<div class="container">

    <h1>🪙 Coin Toss</h1>

    <div class="coin" id="coin">?</div>

    <button onclick="tossCoin()">TOSS COIN</button>

    <div id="result">Tap the button!</div>

    <div class="stats">
        Heads: <span id="heads">0</span> |
        Tails: <span id="tails">0</span>
    </div>

</div>

<script>

let heads = 0;
let tails = 0;

function tossCoin() {

    const coin = document.getElementById("coin");
    const result = document.getElementById("result");

    // Random result
    const random = Math.random();

    // Reset animation
    coin.classList.remove("flipping");

    // Force browser to restart animation
    void coin.offsetWidth;

    coin.classList.add("flipping");

    result.innerHTML = "Flipping... 🪙";

    setTimeout(() => {

        if (random < 0.5) {

            coin.innerHTML = "H";
            result.innerHTML = "HEADS! 🎉";
            heads++;

        } else {

            coin.innerHTML = "T";
            result.innerHTML = "TAILS! 🎉";
            tails++;
        }

        document.getElementById("heads").innerHTML = heads;
        document.getElementById("tails").innerHTML = tails;

    }, 1200);
}

</script>

</body>
</html>
